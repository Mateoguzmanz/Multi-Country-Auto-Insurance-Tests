# Optional. docker-compose.yml already has working fictitious defaults for all of
# these — `docker compose up` works with zero setup. Copy this file to `.env` only if
# you want to override one of them locally.

APP_KEYS=dev-app-key-one,dev-app-key-two,dev-app-key-three,dev-app-key-four
API_TOKEN_SALT=dev-api-token-salt
ADMIN_JWT_SECRET=dev-admin-jwt-secret
JWT_SECRET=dev-jwt-secret
TRANSFER_TOKEN_SALT=dev-transfer-token-salt
ENCRYPTION_KEY=dev-encryption-key
